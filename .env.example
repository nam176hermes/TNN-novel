# Copy to .env and fill in your settings
# Cloud API providers are the default path for P4/P5.
# Keep keys in .env; provider rows in SQLite reference these env var names.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional local fallback provider.
OLLAMA_HOST=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:14b
OLLAMA_API_KEY=
OLLAMA_TEMPERATURE=0.3
OLLAMA_CHUNK_SIZE=3500
OLLAMA_TIMEOUT=180

EDGE_TTS_VOICE=vi-VN-HoaiMyNeural

# Local Vietnamese TTS pipeline. F5-TTS/ViVoice and normalizers are optional
# installs; the app reports clear setup errors if they are missing.
TTS_PROVIDER=f5_vietnamese
TTS_MODEL=vivioice
TTS_MODEL_REPO=hynt/F5-TTS-Vietnamese-ViVoice
# For offline/public deploy, pin these to local files such as:
# data/models/tts/vivoice/model_last.pt and data/models/tts/vivoice/vocab.txt
TTS_CKPT_FILE=
TTS_VOCAB_FILE=
TTS_DEVICE=cuda
TTS_NORMALIZER=vinorm
TTS_OUTPUT_FORMAT=mp3
TTS_CHUNK_MAX_CHARS=450
TTS_CHUNK_MAX_SENTENCES=4
# Use a clean human WAV plus exact transcript for production voice quality.
TTS_REFERENCE_AUDIO_PATH=
TTS_REFERENCE_TEXT=""
TTS_AUDIO_SAMPLE_RATE=24000
TTS_ENABLE_QA=true
TTS_ENABLE_M4B=true
TTS_CACHE=true
TTS_CHUNK_TIMEOUT_SECONDS=120
TTS_CHUNK_RETRIES=2
TTS_QA_RETRIES=2

DATA_DIR=data
LOG_LEVEL=INFO

MOBILE_API_HOST=0.0.0.0
MOBILE_API_PORT=7860
PUBLIC_DEPLOY=0
MOBILE_API_SECRET=change-this-jwt-secret
MOBILE_API_ADMIN_USERNAME=admin
MOBILE_API_ADMIN_PASSWORD=change_me
MOBILE_API_ACCESS_MINUTES=60
MOBILE_API_REFRESH_DAYS=14
MOBILE_API_ASSET_COOKIE_NAME=novel_asset_access
MOBILE_API_UPLOAD_MAX_BYTES=104857600
MOBILE_API_LOGIN_RATE_LIMIT_ATTEMPTS=5
MOBILE_API_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
JOB_STALE_AFTER_SECONDS=300
JOB_HEARTBEAT_INTERVAL_SECONDS=30
MOBILE_API_DISABLE_AUTH=0
MOBILE_API_ALLOW_PUBLIC_AUTH_BYPASS=0
MOBILE_API_CORS_ORIGINS=http://localhost,http://127.0.0.1,capacitor://localhost,https://novel-tnn.tradingcompanydirect.com
MOBILE_API_SERVE_WEB=0
VITE_DISABLE_AUTH=0
WEB_DIST_DIR=web/dist

WEB_PORT=5174
CLOUDFLARE_HOSTNAME=novel-tnn.tradingcompanydirect.com

# ─── Anti-bot bypass (Phase 5+) ──────────────────────────
# Comma-separated proxy URLs. Format: http://user:pass@host:port or http://host:port
# Examples:
# PROXY_LIST=http://user:pass@residential.example.com:8080,http://proxy2.com:8080
# PROXY_LIST=  (empty = no proxy)
PROXY_LIST=

# Captcha solver (2captcha or capsolver). Leave blank to disable.
# Sign up at https://2captcha.com or https://capsolver.com
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=2captcha

# Headless browser fallback (Playwright). Set to "0" to disable.
STEALTH_BROWSER_ENABLED=1
STEALTH_BROWSER_TIMEOUT=60
