# Copy this file to .env and fill in operator-specific values. Never commit .env.
# Provider rows in SQLite reference these environment variable names.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional local fallback provider.
OLLAMA_HOST=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:14b
OLLAMA_API_KEY=
OLLAMA_TEMPERATURE=0.3
OLLAMA_CHUNK_SIZE=3500
OLLAMA_TIMEOUT=180

EDGE_TTS_VOICE=vi-VN-HoaiMyNeural

# F5-TTS/ViVoice and normalizers are optional runtime installs.
TTS_PROVIDER=f5_vietnamese
TTS_MODEL=vivioice
TTS_MODEL_REPO=hynt/F5-TTS-Vietnamese-ViVoice
TTS_CKPT_FILE=
TTS_VOCAB_FILE=
TTS_DEVICE=cuda
TTS_NORMALIZER=vinorm
TTS_OUTPUT_FORMAT=mp3
TTS_CHUNK_MAX_CHARS=450
TTS_CHUNK_MAX_SENTENCES=4
TTS_REFERENCE_AUDIO_PATH=
TTS_REFERENCE_TEXT=
TTS_AUDIO_SAMPLE_RATE=24000
TTS_ENABLE_QA=true
TTS_ENABLE_M4B=true
TTS_CACHE=true
TTS_CHUNK_TIMEOUT_SECONDS=120
TTS_CHUNK_RETRIES=2
TTS_QA_RETRIES=2

DATA_DIR=data
LOG_LEVEL=INFO

# Safe local defaults. Set strong unique credentials before PUBLIC_DEPLOY=1.
MOBILE_API_HOST=127.0.0.1
MOBILE_API_PORT=7860
PUBLIC_DEPLOY=0
MOBILE_API_SECRET=replace-with-a-long-random-secret
MOBILE_API_ADMIN_USERNAME=operator
MOBILE_API_ADMIN_PASSWORD=replace-with-a-strong-password
MOBILE_API_ACCESS_MINUTES=60
MOBILE_API_REFRESH_DAYS=14
MOBILE_API_ASSET_COOKIE_NAME=novel_asset_access
MOBILE_API_UPLOAD_MAX_BYTES=104857600
MOBILE_API_LOGIN_RATE_LIMIT_ATTEMPTS=5
MOBILE_API_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
JOB_STALE_AFTER_SECONDS=300
JOB_HEARTBEAT_INTERVAL_SECONDS=30
IMPORT_JOB_MAX_CHAPTERS=200
IMPORT_JOB_RUN_IN_API=1
IMPORT_WORKER_POLL_INTERVAL_SECONDS=1
IMPORT_WORKER_HEARTBEAT_MAX_AGE_SECONDS=45
IMPORT_JOB_MAX_ACTIVE_PER_USER=4
IMPORT_JOB_MAX_RETRIES_PER_TASK=3
IMPORT_JOB_MAX_BYTES_PER_CHAPTER=5242880
IMPORT_JOB_MAX_DURATION_SECONDS=3600
SOURCE_CIRCUIT_FAILURE_THRESHOLD=3
SOURCE_CIRCUIT_WINDOW_SECONDS=60
SOURCE_CIRCUIT_COOLDOWN_SECONDS=30
# Bounded operational metadata retention. Values must be positive integers.
AUTH_SESSION_RETENTION_DAYS=30
AUTH_SESSION_RETENTION_MAX_ROWS=5000
AUTH_LOGIN_FAILURE_RETENTION_DAYS=30
AUTH_LOGIN_FAILURE_RETENTION_MAX_ROWS=5000
OPERATIONAL_EVENT_RETENTION_DAYS=90
OPERATIONAL_EVENT_RETENTION_MAX_ROWS=50000
OPERATIONAL_RETENTION_BATCH_SIZE=500
OPERATIONAL_RETENTION_INTERVAL_SECONDS=21600
MOBILE_API_DISABLE_AUTH=0
MOBILE_API_ALLOW_PUBLIC_AUTH_BYPASS=0
MOBILE_API_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
MOBILE_API_SERVE_WEB=1
VITE_DISABLE_AUTH=0
VITE_PUBLIC_REVIEW_MODE=0
NOVEL_PUBLIC_REVIEW_MODE=0
WEB_DIST_DIR=web/dist

WEB_PORT=5174
CLOUDFLARE_HOSTNAME=novel.example.com

# Optional anti-bot integrations. Keep credentials only in .env.
PROXY_LIST=
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=capsolver
STEALTH_BROWSER_ENABLED=1
STEALTH_BROWSER_TIMEOUT=30
ENABLE_BROWSER_FALLBACK=1
COOKIE_STORE_DIR=
