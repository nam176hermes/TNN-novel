    "description": "Runtime config extracted from the CN→VI webnovel translation style guide."
  },
  "translation_rules": {
    "default_name_style": "han_viet",
    "preserve_paragraph_breaks": true,
    "system_notification_format": "square_brackets",
    "use_modern_pronouns_in_ancient_setting": false,
    "allow_english_game_terms": "only_if_modern_or_game_context",
    "termbase_priority_order": [
      "novel_specific_locked",
      "global_locked",
      "genre_preferred",
      "contextual"
    ],
    "red_lines": [
      "Không đổi hệ sức mạnh của truyện.",
      "Không Việt hóa tên riêng thành nghĩa thường.",
      "Không dùng đại từ hiện đại trong cổ phong nếu không có chủ ý.",
      "Không lẫn cấp bậc, cảnh giới, phẩm giai.",
      "Không dịch UI hệ thống như văn miêu tả.",
      "Không lạm Hán Việt ở câu thường.",
      "Không tự thêm giải thích vào câu dịch.",
      "Không đổi xưng hô khi quan hệ chưa đổi."
    ]
  },
  "literary_style_guide": [
    "Thơ, thành ngữ, tục ngữ, đối liên, điển cố: dịch theo nghĩa, khí văn và nhịp đọc, không bám từng chữ nếu bản Việt nghe gượng.",
    "Nếu tiếng Việt có thành ngữ tương đương quen thuộc, dùng thành ngữ tương đương.",
    "Nếu không có tương đương tự nhiên, diễn nghĩa bằng văn Việt cổ phong, rõ nghĩa, không dùng slang hiện đại.",
    "Với thơ, câu ngâm, câu quyết và đối liên: giữ hình ảnh chính, sắc thái cổ phong và nhịp đọc; không biến thành văn xuôi thô.",
    "Giữ xuống dòng của thơ/đối liên nếu source có xuống dòng; với một câu thơ ngắn trong thoại, có thể giữ cùng dòng.",
    "Không giải thích điển cố trong ngoặc nếu source không giải thích."
  ],
