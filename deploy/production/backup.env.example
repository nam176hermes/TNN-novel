# Install as ~/.config/novel-tnn/backup.env with mode 0600. Never commit it.
# Use a locally configured SSH alias with a pinned host key.
BACKUP_PASSPHRASE=replace-with-a-random-operator-held-passphrase
OFFSITE_SFTP_HOST=replace-with-ssh-host-alias
OFFSITE_SFTP_DIR=/replace/with/provisioned/novel-tnn-directory

BACKUP_DATA_DIR=/home/thenam176/Novel-TNN/data
BACKUP_LOCAL_DIR=/home/thenam176/.local/share/novel-tnn-backups
BACKUP_IMAGE=novel-pipeline-api:runtime-hardening-20260718-r1
BACKUP_KEEP_LOCAL=14
BACKUP_KEEP_OFFSITE=35
