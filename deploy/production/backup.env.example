# Install as ~/.config/novel-tnn/backup.env with mode 0600. Never commit it.
# Cloudflare R2 object credentials must be scoped to this one private bucket.
BACKUP_PASSPHRASE=replace-with-a-random-operator-held-passphrase
R2_ACCOUNT_ID=replace-with-32-character-cloudflare-account-id
R2_BUCKET=novel-tnn-backups
R2_PREFIX=novel-tnn-production
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

BACKUP_DATA_DIR=/home/thenam176/Novel-TNN/data
BACKUP_LOCAL_DIR=/home/thenam176/.local/share/novel-tnn-backups
BACKUP_IMAGE=novel-pipeline-api@sha256:replace-with-reviewed-64-character-image-digest
# Must exactly match NOVEL_RELEASE_ID embedded in BACKUP_IMAGE and the running API.
RECOVERY_PRODUCER_VERSION=replace-with-reviewed-release-id
BACKUP_KEEP_LOCAL=14
BACKUP_KEEP_OFFSITE=35
