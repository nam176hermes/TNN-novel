# Install as ~/.config/novel-tnn/alert.env with mode 0600. Never commit the installed file.
# Production webhooks must use HTTPS. HTTP is reserved for the isolated smoke command.
NOVEL_ALERT_WEBHOOK_URL=https://alerts.example.invalid/operational-alerts
NOVEL_ALERT_WEBHOOK_BEARER_TOKEN=
NOVEL_ALERT_TIMEOUT_SECONDS=5
NOVEL_ALERT_MAX_ATTEMPTS=3
