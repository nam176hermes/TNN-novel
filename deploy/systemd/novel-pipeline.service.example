[Unit]
Description=Novel Pipeline FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thenam176
Group=thenam176
WorkingDirectory=/home/thenam176/novel_pipeline
EnvironmentFile=/etc/novel-pipeline/novel-pipeline.env
Environment=PYTHONUNBUFFERED=1
Environment=MOBILE_API_HOST=0.0.0.0
Environment=MOBILE_API_PORT=7860
Environment=MOBILE_API_SERVE_WEB=1
Environment=WEB_DIST_DIR=/home/thenam176/novel_pipeline/web/dist
Environment=DATA_DIR=/home/thenam176/novel_pipeline/data
ExecStart=/home/thenam176/novel_pipeline/.venv/bin/python -m app.mobile_api
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
